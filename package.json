{
  "name": "movie-app-monorepo",
  "version": "1.0.93",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @movie-app/mobile start",
    "mobile:ios": "pnpm --filter @movie-app/mobile ios",
    "mobile:android": "pnpm --filter @movie-app/mobile android",
    "desktop:dev": "pnpm --filter @movie-app/desktop tauri:dev",
    "desktop:build": "pnpm --filter @movie-app/desktop tauri:build",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "push": "bash -c 'git add . && git commit -m \"$1\" && git push github master && git push origin master && tag=v$(node -p \"require(\\\"./package.json\\\").version\") && git tag $tag && git push github $tag && git push origin $tag' --",
    "release": "pnpm push"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
    }
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {}
}
